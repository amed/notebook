{
  "name": "notebook",
  "version": "0.1.0",
  "private": true,
  "description": "A zero-knowledge encrypted Markdown vault backed by a user-owned S3 bucket.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "check:budgets": "node scripts/check-budgets.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:mac": "bash scripts/build-mac.sh",
    "test": "npm run check && npm run test:unit && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "test:leak": "node --test \"tests/leak/*.test.mjs\"",
    "audit": "npm audit --omit=dev && cargo audit --file src-tauri/Cargo.lock && cargo deny --manifest-path src-tauri/Cargo.toml --locked check",
    "version:set": "node scripts/set-version.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "check:web": "tsc --noEmit -p web/tsconfig.json",
    "build:web": "tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "test:web": "node --test \"tests/web/*.test.mjs\"",
    "test:web:browser": "node --test \"tests/web/browser/*.test.mjs\"",
    "test:web:e2e": "bash scripts/web-e2e.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@noble/ciphers": "2.4.0",
    "@tauri-apps/api": "2.12.0",
    "dompurify": "3.4.16",
    "marked": "18.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "playwright-core": "1.59.1",
    "selenium-webdriver": "4.49.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
