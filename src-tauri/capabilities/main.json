{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimum permissions for the Notebook main window",
  "windows": ["main"],
  "permissions": [
    "allow-config-get",
    "allow-settings-set",
    "allow-layout-set",
    "allow-workspaces-list",
    "allow-workspace-save",
    "allow-workspace-delete",
    "allow-workspace-select",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-passphrase-change",
    "allow-activity-ping",
    "allow-tree-get",
    "allow-folder-create",
    "allow-doc-create",
    "allow-node-rename",
    "allow-node-move",
    "allow-node-trash",
    "allow-trash-restore",
    "allow-trash-purge",
    "allow-trash-empty",
    "allow-doc-open",
    "allow-doc-stage",
    "allow-doc-commit",
    "allow-flush-all",
    "allow-image-add",
    "allow-preview-render",
    "allow-link-open",
    "allow-close-after-flush",
    "allow-cancel-close",
    "allow-open-document-window",
    "allow-document-windows-close",
    "core:event:allow-listen",
    "core:window:allow-set-title"
  ]
}
