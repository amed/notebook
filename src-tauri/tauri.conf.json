{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notebook",
  "version": "0.1.0",
  "identifier": "com.securemd.vault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; worker-src 'none'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Notebook",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "devtools": false,
        "generalAutofillEnabled": false,
        "create": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "shortDescription": "Encrypted Markdown notebook backed by your own S3 bucket",
    "longDescription": "A small desktop Markdown editor that encrypts documents, images, and names before storing ciphertext in your S3 bucket, in the format of the original Notebook app.",
    "category": "Productivity",
    "publisher": "Notebook contributors",
    "copyright": "Notebook contributors",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Notebook Vault"
      },
      "wix": {
        "upgradeCode": "08062c0b-9240-5662-a76f-d07edbb452d3"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libdbus-1-3"
        ],
        "recommends": [
          "gnome-keyring"
        ]
      },
      "rpm": {
        "depends": [
          "dbus-libs"
        ],
        "recommends": [
          "gnome-keyring"
        ]
      }
    }
  }
}
