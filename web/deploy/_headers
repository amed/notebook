# Response headers for Netlify and Cloudflare Pages. `npm run build:web`
# copies this file to dist-web/_headers with %NOTEBOOK_CSP% replaced by the
# policy of web/index.html (the same string as its <meta> tag, which already
# lists the S3 origins from NOTEBOOK_WEB_CONNECT_SRC). The header adds what a
# <meta> policy cannot: frame-ancestors. For nginx see nginx.conf.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/
  Content-Security-Policy: %NOTEBOOK_CSP%; frame-ancestors 'none'
  X-Frame-Options: DENY
  Cache-Control: no-cache

/index.html
  Content-Security-Policy: %NOTEBOOK_CSP%; frame-ancestors 'none'
  X-Frame-Options: DENY
  Cache-Control: no-cache

# The HTML preview frame: framed by the app only, nothing in it may load or run.
/preview.html
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src data:; media-src data:; font-src data:; form-action 'none'; base-uri 'none'; frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
